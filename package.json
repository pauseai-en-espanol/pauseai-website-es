{
	"type": "module",
	"name": "pause-ai",
	"version": "1.1.7",
	"private": true,
	"packageManager": "pnpm@12.18.0",
	"scripts": {
		"clean": "tsx scripts/clean.ts",
		"inlang:settings": "tsx scripts/inlang-settings.ts",
		"l10n": "tsx scripts/l10n/run",
		"dev": "vite dev --host 0.0.0.0",
		"build": "cross-env NODE_ENV=production node scripts/filter-build-log.js \"tsx scripts/l10n/run && vite build --emptyOutDir=false\"",
		"test": "vitest",
		"preview": "vite preview",
		"check": "run-s _check:*",
		"_check:svelte": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"_check:other": "tsc --noEmit -p tsconfig.check.json",
		"check:watch": "echo This commands only checks the SvelteKit code, not the build scripts. && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "run-s _lint:*",
		"_lint:knip": "knip",
		"_lint:eslint": "eslint . --max-warnings=46",
		"_lint:stylelint": "stylelint \"src/**/*.{css,svelte}\"",
		"_lint:prettier": "tsx scripts/generate-prettier-ignore.ts && prettier --check .",
		"format": "tsx scripts/generate-prettier-ignore.ts && prettier --write --ignore-unknown",
		"prepare": "lefthook install && (svelte-kit sync || echo '')",
		"sync": "svelte-kit sync",
		"docker:build": "docker buildx build ${DOCKER_PLATFORM:+--platform=$DOCKER_PLATFORM} -t \"${DOCKER_REGISTRY:+${DOCKER_REGISTRY}/}pauseai-es/pauseai-website-es:${npm_package_version}${DOCKER_TAG_SUFFIX:+.${DOCKER_TAG_SUFFIX}}\" .",
		"docker:push": "docker push \"${DOCKER_REGISTRY:+${DOCKER_REGISTRY}/}pauseai-es/pauseai-website-es:${npm_package_version}${DOCKER_TAG_SUFFIX:+.${DOCKER_TAG_SUFFIX}}\""
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@eslint/markdown": "^8.0.3",
		"@inlang/paraglide-js": "^3.2.1",
		"@sveltejs/adapter-node": "^6.0.2",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/escape-html": "^1.0.4",
		"@types/glidejs__glide": "^3.6.6",
		"@types/mdast": "^4.0.4",
		"@types/minimist": "^1.2.5",
		"@types/node": "^26.6.6",
		"@types/remark-heading-id": "^1.0.0",
		"@types/ua-parser-js": "^0.7.39",
		"axios-mock-adapter": "^2.1.0",
		"axios-retry": "^4.5.0",
		"cross-env": "^10.1.0",
		"dotenv": "^18.0.10",
		"eslint": "^10.14.0",
		"eslint-config-flat-gitignore": "^2.4.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"fontaine": "^1.0.3",
		"globals": "^17.14.0",
		"globby": "^16.2.4",
		"knip": "^6.45.0",
		"lefthook": "^2.2.2",
		"mdsvex": "^0.12.8",
		"minimatch": "^11.0.6",
		"minimist": "^1.2.8",
		"npm-run-all2": "^9.0.4",
		"p-queue": "^10.0.0",
		"postcss-discard-duplicates": "^9.0.7",
		"postcss-html": "^2.0.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"remark-heading-id": "^1.0.1",
		"remove-markdown": "^0.8.0",
		"schema-dts": "^2.1.0",
		"simple-git": "^4.0.2",
		"stylelint": "^18.0.0",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.2",
		"unist-util-visit": "^5.2.0",
		"vite": "^8.3.7",
		"vite-imagetools": "^12.0.1",
		"vitest": "^5.1.0"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^1.8.0",
		"@fontsource/roboto-slab": "^5.3.0",
		"@fontsource/saira-condensed": "^5.3.0",
		"@glidejs/glide": "~3.7.1",
		"@lucide/svelte": "^1.71.0",
		"@number-flow/svelte": "^0.4.2",
		"@pagefind/component-ui": "^1.6.0",
		"@pagefind/default-ui": "^1.6.0",
		"@prgm/sveltekit-progress-bar": "^3.0.2",
		"@remix-run/headers": "^1.1.0",
		"@turf/distance": "^7.4.0",
		"airtable": "^0.12.2",
		"axios": "^1.21.1",
		"clipboard-polyfill": "^4.1.1",
		"clsx": "^2.1.1",
		"escape-html": "^1.0.3",
		"github-slugger": "^2.0.0",
		"html-to-image": "^1.11.13",
		"http-status-codes": "^2.3.0",
		"maplibre-gl": "^6.17.0",
		"maplibregl-mapbox-request-transformer": "^0.0.3",
		"micromark": "^4.0.3",
		"motion-sv": "^0.2.2",
		"node-ical": "^0.27.6",
		"pagefind": "^1.6.0",
		"pure-rand": "^8.4.2",
		"rehype-slug": "^6.0.0",
		"rehype-unwrap-images": "^1.0.0",
		"remark-toc": "^9.0.0",
		"snakecase-keys": "^9.0.2",
		"svelte-french-toast": "^1.2.0",
		"svelte-markdown": "^0.4.1",
		"svelte-toc": "^0.7.0",
		"ua-parser-js": "^2.0.10"
	},
	"engines": {
		"node": "^26.13.1",
		"pnpm": "^12.18.0"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.18.0",
			"onFail": "download"
		}
	}
}
